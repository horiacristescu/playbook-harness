#!/bin/bash
# pb-agy — launch Antigravity CLI (agy) with provider-native identity.
#
# Usage: pb-agy [agy-args...]
#
# Agy owns the conversation ID. Its hooks expose `conversationId` and Bash
# commands expose the same value as ANTIGRAVITY_CONVERSATION_ID. This wrapper
# therefore scrubs a parent agent's identity and never invents a replacement.
#
# Canonical user-facing entry point. See src/provider/adapters/antigravity.py
# launch_interactive() for the programmatic equivalent (assumes env pre-set).

set -e
export PYTHONDONTWRITEBYTECODE=1

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
RUNTIME_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
SHARED_LIB="$RUNTIME_ROOT/scripts/gate-echo-lib.sh"
if [ ! -f "$SHARED_LIB" ]; then
    echo "Error: Playbook shared runtime missing: $SHARED_LIB" >&2
    exit 1
fi
# shellcheck source=../scripts/gate-echo-lib.sh
. "$SHARED_LIB"

PROJECT_ROOT="$(find_project_root)"

unset PLAYBOOK_SESSION_ID PLAYBOOK_BRIDGE_PROVIDER PLAYBOOK_ROLE
unset CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID ANTIGRAVITY_CONVERSATION_ID
export PLAYBOOK_PROVIDER="antigravity"
export PLAYBOOK_PROJECT_ROOT="$PROJECT_ROOT"

exec agy "$@"
