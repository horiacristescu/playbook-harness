#!/bin/bash
# pb-codex — launch Codex without inheriting another agent's identity.
#
# Usage: pb-codex [codex-args...]
#
# Codex itself owns the durable thread ID. The wrapper only establishes project
# and provider context; hooks and commands read Codex's native `session_id` /
# `CODEX_THREAD_ID`. AGENTS.md tells the agent to bootstrap first.
#
# Canonical user-facing entry point.  See src/provider/adapters/codex.py
# launch_interactive() for the programmatic equivalent (assumes env pre-set).

set -e
export PYTHONDONTWRITEBYTECODE=1

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
RUNTIME_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
SHARED_LIB="$RUNTIME_ROOT/scripts/gate-echo-lib.sh"
if [ ! -f "$SHARED_LIB" ]; then
    echo "Error: Playbook shared runtime missing: $SHARED_LIB" >&2
    exit 1
fi
# shellcheck source=../scripts/gate-echo-lib.sh
. "$SHARED_LIB"

PROJECT_ROOT="$(find_project_root)"

if [ "${1:-}" = "loop" ]; then
    shift
    exec python3 "$RUNTIME_ROOT/scripts/codex-loop.py" "$@"
fi

# A nested agent must not inherit the parent's provider or normalized identity.
unset PLAYBOOK_SESSION_ID CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID \
    ANTIGRAVITY_CONVERSATION_ID PLAYBOOK_BRIDGE_PROVIDER PLAYBOOK_ROLE
export PLAYBOOK_PROVIDER="codex"
export PLAYBOOK_PROJECT_ROOT="$PROJECT_ROOT"

# A window started with --no-daemon runs its session in its own process, so its
# hooks and commands (and `pb-codex loop`) run under this window with this
# environment. Under the shared background server they would not.
opens_window() {
    local first=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-daemon|--remote|--remote=*) return 1 ;;
            --) break ;;
            -c|--config|--enable|--disable|--remote-auth-token-env|-i|--image|-m|--model|\
            --local-provider|-p|--profile|-s|--sandbox|-C|--cd|--add-dir|-a|--ask-for-approval)
                shift ;;
            -*) ;;
            *) [ -n "$first" ] || first="$1" ;;
        esac
        [ $# -gt 0 ] && shift
    done
    case "$first" in
        agents|exec|e|review|login|logout|mcp|mcp-server|plugin|app-server|remote-control|app|\
        completion|update|doctor|sandbox|debug|apply|a|queue|archive|delete|migrate-rollouts|\
        unarchive|cloud|exec-server|features|help|proxy) return 1 ;;
    esac
    return 0
}

if opens_window "$@"; then
    exec codex --no-daemon "$@"
fi
exec codex "$@"
