#!/bin/bash
# task-gate-hook
# PreToolUse hook — guards:
#   0. Write — block creating new task.md files (only pb-tasks new CLI does that)
#   1. Edit/Write/MultiEdit on code files blocked when no task is active (exit 2 = BLOCK)
#   2-mkdir. Bash — block manual task directory creation
#
# Allows: .agent/, .claude/ edits (task management, hook config)

set -e

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"

# is_code_file_path FILE_PATH
# Returns 0 for source code paths that should require an active task.
# Covers both extension-based code files and extensionless executable/script paths
# that live in known code directories.
is_code_file_path() {
    local file_path="$1"
    case "$file_path" in
        *.py|*.ts|*.js|*.tsx|*.jsx|*.sh|*.bash|*.go|*.rs|*.rb|*.java|*.c|*.cpp|*.h|*.hpp|*.swift|*.kt|*.kts|*.dart|*.cs|*.php|*.r|*.R|*.m|*.mm|*.scala|*.zig|*.lua|*.ex|*.exs|*.ml|*.mli|*.tf|*.vue|*.svelte)
            return 0
            ;;
        */.claude/bin/*|*/bin/*|*/src/hooks/*)
            return 0
            ;;
        */scripts/*)
            case "$file_path" in
                *.md|*.txt|*.json|*.png|*.svg|*.css|*.html) return 1 ;;
                *) return 0 ;;
            esac
            ;;
    esac

    # Existing extensionless script with shebang outside the common directories.
    if [ -f "$file_path" ] && head -1 "$file_path" 2>/dev/null | grep -q '^#!'; then
        return 0
    fi

    return 1
}

# Permanent protection for the installed Playbook runtime. This covers native
# structured Edit/Write events. Arbitrary Bash commands are protected by
# pb-sandbox's filesystem policy; this hook deliberately does not pretend to be
# a complete shell parser.
is_runtime_path() {
    local file_path="$1"
    local runtime_root="${PLAYBOOK_RUNTIME_ROOT:-$(cd "$HOOK_DIR/.." && pwd)}"
    if [ "$(cd "$PROJECT_DIR" && pwd)" = "$runtime_root" ]; then
        return 1
    fi
    python3 - "$runtime_root" "$file_path" <<'PY'
import os
import sys

root = os.path.realpath(sys.argv[1])
path = os.path.realpath(sys.argv[2])
try:
    inside = os.path.commonpath((root, path)) == root
except ValueError:
    inside = False
raise SystemExit(0 if inside else 1)
PY
}

# Find project root
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    cat > /dev/null
    exit 0
fi

AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR")

CLAUDE_MD="$PROJECT_DIR/CLAUDE.md"

# CLAUDE.md keyword check — warn if task system exists but CLAUDE.md doesn't mention it
if [ -d "$AGENT_DIR/tasks" ] && [ -f "$CLAUDE_MD" ]; then
    if ! grep -qE 'pb-tasks bootstrap|pb-tasks work' "$CLAUDE_MD" 2>/dev/null; then
        cat >&2 <<'MSG'
WARNING: CLAUDE.md doesn't mention the task system. Essential commands:
  pb-tasks bootstrap          — load context
  pb-tasks work <N>           — activate task
  pb-tasks work done          — deactivate
  pb-tasks new <type> <name>  — create task
  pb-tasks list               — see all tasks
MSG
    fi
fi

# Read stdin (PreToolUse JSON)
INPUT=$(cat)

# This entrypoint is Claude-specific even when a nested launch inherited a
# parent provider environment.
PROVIDER="$(resolve_hook_provider)"
if ! SESSION_ID="$(resolve_hook_session_id "$PROVIDER" "$INPUT")"; then
    echo "BLOCKED: Playbook cannot establish the provider-native session identity." >&2
    exit 2
fi
TOOL_NAME=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_name',''))" 2>/dev/null || echo "")

SESSION_DIR="$(ensure_session_dir "$AGENT_DIR" "$PROVIDER" "$SESSION_ID")"
STATE_FILE="$SESSION_DIR/current_state"
AUTHORITY_TASK=""
AUTHORITY_ERROR=""
if [ -f "$STATE_FILE" ]; then
    if ! AUTHORITY_TASK=$(validate_task_authority "$AGENT_DIR" "$PROVIDER" "$SESSION_ID" 2>&1); then
        AUTHORITY_ERROR="$AUTHORITY_TASK"
        AUTHORITY_TASK=""
    fi
fi

# --- Guard 0: Write — block creating new task.md files (only pb-tasks new CLI does that) ---
if [ "$TOOL_NAME" = "Write" ]; then
    FILE_PATH=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")

    # Check if it's a task.md in .agent/tasks/ that doesn't exist yet
    if echo "$FILE_PATH" | grep -qE '\.agent(/[^/]+)?/tasks/[^/]+/task\.md$'; then
        if [ ! -f "$FILE_PATH" ]; then
            cat >&2 <<'MSG'
BLOCKED: Only `pb-tasks new` creates task.md files.

Don't create task files manually. The CLI enforces templates and numbering.

Use:  pb-tasks new <type> <name>
Types include: feature, bugfix, refactor, cleanup, ops, audit, eval, research, monitor, quick
MSG
            exit 2
        fi
    fi
fi

# --- Guard 0.5: Natural task.md edit validation ---
# The hook supplies the instruction pointer; the agent closes it with its
# provider-native file editor. Keep gate order and ownership behind this hook.
# Must run BEFORE the .agent/* early-exit in Guard 1.
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ] || [ "$TOOL_NAME" = "MultiEdit" ]; then
    # Extract file_path (reuse from Guard 0 for Write, extract for Edit)
    if [ -z "$FILE_PATH" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")
    fi
    if [ -z "$FILE_PATH" ]; then
        echo "BLOCKED: Structured mutation payload has no valid file_path." >&2
        exit 2
    fi
    case "$FILE_PATH" in
        *$'\n'*|*$'\r'*)
            echo "BLOCKED: Structured mutation payload has no valid file_path." >&2
            exit 2
            ;;
    esac

    # Task-control files are governed even though ordinary .agent Markdown is
    # not. Only the task confirmed by task.md ownership may be edited.
    if echo "$FILE_PATH" | grep -qE '\.agent(/[^/]+)?/tasks/[^/]+/task\.md$'; then
        if [ -n "$AUTHORITY_ERROR" ]; then
            echo "BLOCKED: Playbook task authority mismatch: $AUTHORITY_ERROR" >&2
            exit 2
        fi
        if [ -z "$AUTHORITY_TASK" ]; then
            echo "BLOCKED: Task-control edits require an authoritative session claim. Run pb-tasks work <N>." >&2
            exit 2
        fi
        TARGET_REAL=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$FILE_PATH")
        ACTIVE_REAL=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$AUTHORITY_TASK")
        if [ "$TARGET_REAL" != "$ACTIVE_REAL" ]; then
            echo "BLOCKED: Task-control edit targets $TARGET_REAL, but this session owns $ACTIVE_REAL." >&2
            exit 2
        fi
        if ! echo "$INPUT" | python3 "$HOOK_DIR/task-gate-validate.py" "$AUTHORITY_TASK"; then
            exit 2
        fi
    fi
fi

# --- Guard 1: structured edits — require active task for code files ---
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ] || [ "$TOOL_NAME" = "MultiEdit" ]; then
    # Reuse FILE_PATH from Guard 0/0.5 if already set
    if [ -z "$FILE_PATH" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")
    fi

    if [ -n "$FILE_PATH" ] && is_runtime_path "$FILE_PATH"; then
        echo "BLOCKED: the installed Playbook runtime is read-only during agent work: $FILE_PATH" >&2
        exit 2
    fi

    if [ -n "$AUTHORITY_ERROR" ]; then
        echo "BLOCKED: Playbook task authority mismatch: $AUTHORITY_ERROR" >&2
        exit 2
    fi

    # Allow .agent/ and .claude/ edits (task management, hook config)
    case "$FILE_PATH" in
        */.agent/*|*/.claude/*) exit 0 ;;
    esac

    # Only block code files
    if ! is_code_file_path "$FILE_PATH"; then
        exit 0
    fi

    # Check for active task
    if [ -n "$AUTHORITY_TASK" ]; then
        exit 0
    fi

    # No active task — block code edit
    cat >&2 <<'MSG'
BLOCKED: No active task.

Code edits require an active task so work is tracked and directed.

Workflow:
  1. pb-tasks new <type> <name>   — create task
  2. pb-tasks work <N>            — activate immediately (don't wait)
  3. ... do the work gate by gate ...
  4. pb-tasks work done           — deactivate when finished

To resume an existing task:  pb-tasks work <N>
MSG
    exit 2
fi

# --- Guard 2: Bash — inject session_id + block manual task dir creation ---
if [ "$TOOL_NAME" = "Bash" ]; then
    CMD=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('command',''))" 2>/dev/null || echo "")

    # Inject PLAYBOOK_SESSION_ID into tasks CLI commands via updatedInput
    if [ -n "$SESSION_ID" ] && echo "$CMD" | grep -qE '(^|[;&|] *)([^ ]*/)?(pb-)?tasks (work|status|bootstrap|freehand|retro|new)'; then
        UPDATED_CMD="export PLAYBOOK_SESSION_ID='$SESSION_ID'; export PLAYBOOK_PROVIDER='$PROVIDER'; $CMD"
        JSON_CMD=$(echo "$UPDATED_CMD" | python3 -c "import sys,json; print(json.dumps(sys.stdin.read().rstrip()))" 2>/dev/null)
        cat <<EOFX
{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":${JSON_CMD}}}}
EOFX
        exit 0
    fi

    # Guard 3: judge session — block task management commands
    if [ "$SESSION_ID" = "judge" ] && echo "$CMD" | grep -qE '(^|[;&|] *)([^ ]*/)?(pb-)?tasks (new|work)'; then
        cat >&2 <<'MSG'
BLOCKED: Judge session cannot create or activate tasks.

The judge reviews plans — it doesn't manage tasks.
MSG
        exit 2
    fi

    if echo "$CMD" | grep -qE 'mkdir.*\.agent(/[^/]+)?/tasks/'; then
        cat >&2 <<'MSG'
BLOCKED: Don't create task directories manually.

Use `pb-tasks new <type> <name>` to create tasks. The CLI enforces templates and numbering.

Types include: feature, bugfix, refactor, cleanup, ops, audit, eval, research, monitor, quick
MSG
        exit 2
    fi
fi

# Everything else — allow
exit 0
