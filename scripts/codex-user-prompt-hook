#!/usr/bin/env python3


"""Log Codex prompts for task context recovery."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def _bootstrap_imports() -> None:
    script_dir = Path(__file__).resolve().parent
    candidates = [script_dir.parent / "src"]
    for candidate in candidates:
        if candidate.exists():
            sys.path.insert(0, str(candidate))
            return


def _find_project_root() -> Path:
    env_root = os.environ.get("PLAYBOOK_PROJECT_ROOT")
    from provider.codex_hooks import find_project_root
    return find_project_root(Path.cwd(), Path(env_root) if env_root else None)


def main() -> int:
    _bootstrap_imports()
    from provider.codex_hooks import (
        append_prompt_to_chat_log,
        session_state_dir,
    )

    payload = json.load(sys.stdin)
    prompt = payload.get("prompt")

    project_root = _find_project_root()
    from provider.session_identity import hook_session_id
    session_id = hook_session_id("codex", payload, os.environ)
    # Validate the entire state boundary before chat-log mutation.
    session_state_dir(project_root, session_id)
    append_prompt_to_chat_log(project_root, session_id, prompt)
    if os.environ.get("PLAYBOOK_SESSION_NAME", "").strip():
        # Codex has no start hook: the first prompt records the launch name.
        from provider.session_state import SessionKey
        from session_cli import claim_launch_name
        from tasks.core import resolve_agent_dir

        try:
            claim_launch_name(
                resolve_agent_dir(project_root), SessionKey.from_values("codex", session_id)
            )
        except Exception as exc:  # noqa: BLE001 - never block the prompt
            print(f"Playbook: session name not recorded: {exc}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
