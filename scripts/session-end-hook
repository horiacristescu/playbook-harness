#!/bin/bash
# session-end-hook
# SessionEnd hook — removes transient counters while preserving resumable state.

set -e

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"

# Find project root
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    exit 0
fi

AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR")

# Skip cleanup if .agent/ isn't writable (sandbox mode)
if ! agent_dir_writable "$PROJECT_DIR"; then
    exit 0
fi

INPUT=$(cat)
PROVIDER="$(resolve_hook_provider)"
if ! SESSION_ID="$(resolve_hook_session_id "$PROVIDER" "$INPUT")"; then
    echo "[session-end-hook] native session identity unavailable; no cleanup performed" >&2
    exit 0
fi

# Preserve current_state and chat offset: exact provider resume must recover the
# same Playbook task. Only transient per-turn counters are safe to discard.
if ! SESSION_DIR="$(ensure_session_dir "$AGENT_DIR" "$PROVIDER" "$SESSION_ID")"; then
    echo "[session-end-hook] session path is not confined; no cleanup performed" >&2
    exit 0
fi
rm -f "$SESSION_DIR/counters"

exit 0
